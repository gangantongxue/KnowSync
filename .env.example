# ============================================
# KnowSync 环境变量配置
# ============================================
# 复制此文件为 .env 并根据实际环境修改配置:
#   cp .env.example .env
#
# 各服务通过 viper 读取对应前缀的环境变量覆盖 config.yaml 中的默认值
# ============================================

# ============================================
# MySQL (Docker 镜像原生变量)
# ============================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=knowsync

# ============================================
# user-server (前缀: KNOWSYNC_USER_SERVER)
# ============================================
KNOWSYNC_USER_SERVER_DATABASE_HOST=mysql
KNOWSYNC_USER_SERVER_EMAIL_SMTP_HOST=smtp.163.com
KNOWSYNC_USER_SERVER_EMAIL_SMTP_PORT=465
KNOWSYNC_USER_SERVER_EMAIL_USERNAME=your_email@163.com
KNOWSYNC_USER_SERVER_EMAIL_PASSWORD=your_auth_code
KNOWSYNC_USER_SERVER_EMAIL_FROM_ADDRESS=your_email@163.com
KNOWSYNC_USER_SERVER_EMAIL_FROM_NAME=KnowSync
KNOWSYNC_USER_SERVER_DATABASE_PORT=3306
KNOWSYNC_USER_SERVER_DATABASE_USER=root
KNOWSYNC_USER_SERVER_DATABASE_PASSWORD=your_db_password
KNOWSYNC_USER_SERVER_DATABASE_DBNAME=knowsync
KNOWSYNC_USER_SERVER_REDIS_ADDRS=redis:6379
KNOWSYNC_USER_SERVER_REDIS_PASSWORD=
KNOWSYNC_USER_SERVER_REDIS_DB=0
KNOWSYNC_USER_SERVER_GRPC_PORT=50051

# ============================================
# repo-server (前缀: KNOWSYNC_REPO_SERVER)
# ============================================
KNOWSYNC_REPO_SERVER_DATABASE_HOST=mysql
KNOWSYNC_REPO_SERVER_DATABASE_PORT=3306
KNOWSYNC_REPO_SERVER_DATABASE_USER=root
KNOWSYNC_REPO_SERVER_DATABASE_PASSWORD=your_db_password
KNOWSYNC_REPO_SERVER_DATABASE_DBNAME=knowsync
KNOWSYNC_REPO_SERVER_GRPC_PORT=50052

# ============================================
# gateway (前缀: KNOWSYNC_GATEWAY)
# ============================================
KNOWSYNC_GATEWAY_HTTP_PORT=8080
KNOWSYNC_GATEWAY_GRPC_CLIENTS_TARGETS_USER_SERVER=user-server:50051
KNOWSYNC_GATEWAY_GRPC_CLIENTS_TARGETS_REPO_SERVER=repo-server:50052
KNOWSYNC_GATEWAY_GRPC_CLIENTS_TARGETS_AI_SERVER=ai-server:50053

# ============================================
# ai-server (前缀: KNOWSYNC_AI_SERVER)
# ============================================
KNOWSYNC_AI_SERVER_GRPC_PORT=8082
KNOWSYNC_AI_SERVER_REDIS_ADDRS=redis:6379
KNOWSYNC_AI_SERVER_REPO_SERVER_ADDR=repo-server:50052
KNOWSYNC_AI_SERVER_GATEWAY_ADDR=http://gateway:8080
KNOWSYNC_AI_SERVER_EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
KNOWSYNC_AI_SERVER_EMBEDDER_API_KEY=your_siliconflow_api_key
KNOWSYNC_AI_SERVER_EMBEDDER_MODEL=Qwen/Qwen3-Embedding-8B
KNOWSYNC_AI_SERVER_EMBEDDER_DIMENSIONS=1536
KNOWSYNC_AI_SERVER_LLM_BASE_URL=https://api.deepseek.com/v1
KNOWSYNC_AI_SERVER_LLM_API_KEY=your_deepseek_api_key
KNOWSYNC_AI_SERVER_LLM_MODEL=deepseek-chat
